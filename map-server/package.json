{
  "name": "img-map-server",
  "version": "1.0.0",
  "description": "Serves Garmin .img maps as map tiles, with a widget that shows them on any web page",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "node check.mjs"
  },
  "dependencies": {
    "@maplibre/vt-pbf": "^4.3.2",
    "lineclip": "^2.0.0",
    "maplibre-gl": "^6.11.2"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/node": "^26.6.3",
    "pbf": "^5.1.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
